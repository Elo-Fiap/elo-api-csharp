<Project Sdk="Microsoft.NET.Sdk">

  <!-- Módulo de Cybersecurity: parsing de PII, taint analysis e registro de eventos de segurança.
       Biblioteca pura: não depende do ASP.NET nem do EF Core, só das abstrações do .NET. -->
  <PropertyGroup>
    <RootNamespace>Elo.Seguranca</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>

</Project>
